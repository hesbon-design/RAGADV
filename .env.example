# Authentication
ADMIN_PASSWORD=admin123
SESSION_SECRET=ragadv_secure_session_secret_min_32_characters_long_12345

# Database (Local SQLite)
DATABASE_PATH=./data/ragadv.db

# LLM Providers (Google Gemini by default)
GEMINI_API_KEY=
