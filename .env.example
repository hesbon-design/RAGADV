# Authentication
ADMIN_PASSWORD=admin123
SESSION_SECRET=ragadv_secure_session_secret_min_32_characters_long_12345

# Database (PostgreSQL 16 with pgvector / Supabase)
DATABASE_URL=postgres://ragadv:ragadv_dev_password@localhost:5432/ragadv

# LLM Providers (Google Gemini by default)
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=google
GEMINI_MODEL=gemini-2.5-flash

# Storage (Cloudflare R2 / AWS S3 in prod, local files in dev)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/storage
S3_BUCKET=ragadv-reports
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
